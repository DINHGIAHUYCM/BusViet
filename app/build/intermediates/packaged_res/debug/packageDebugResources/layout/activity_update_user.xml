        <!--  Phone  -->
        <TextView android:text="Số điện thoại" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="14sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/editPhone" android:hint="Nhập số điện thoại" android:inputType="phone" android:background="@drawable/edit_text_bg" android:padding="12dp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <!--  Contact  -->
        <TextView android:text="Địa chỉ" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="14sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/editContact" android:hint="Nhập địa chỉ" android:inputType="text" android:background="@drawable/edit_text_bg" android:padding="12dp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <!--  New Password  -->
        <TextView android:text="Mật khẩu mới" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="14sp" android:layout_marginBottom="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/edit_text_bg" android:paddingEnd="12dp" android:layout_marginBottom="12dp">
            <EditText android:id="@+id/editPassword" android:layout_weight="1" android:inputType="textPassword" android:padding="12dp" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <ImageView android:id="@+id/showPass" android:src="@android:drawable/ic_menu_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp"/>
        </LinearLayout>
        <!--  Confirm Password  -->
        <TextView android:text="Xác nhận mật khẩu" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="14sp" android:layout_marginBottom="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/edit_text_bg" android:paddingEnd="12dp" android:layout_marginBottom="24dp">
            <EditText android:id="@+id/editRePassword" android:layout_weight="1" android:inputType="textPassword" android:padding="12dp" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <ImageView android:id="@+id/showRePass" android:src="@android:drawable/ic_menu_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp"/>
        </LinearLayout>
        <!--  Update Button  -->
        <Button android:id="@+id/buttonUpdate" android:text="Cập nhật" android:textColor="#FFFFFF" android:backgroundTint="#E60000" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="16dp"/>
        <!--  Back Button  -->
        <Button android:id="@+id/buttonBack" android:layout_width="match_parent" android:layout_height="48dp" android:text="Quay lại" android:textColor="@android:color/white" android:background="@drawable/btn_rounded_blue" android:textAllCaps="false" android:textSize="16sp" android:layout_marginBottom="16dp"/>
    </LinearLayout>
</ScrollView>