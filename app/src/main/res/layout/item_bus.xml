<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_bus_item"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvRouteCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã tuyến"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#007A33" />

    <TextView
        android:id="@+id/tvRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Điểm đầu ➜ Điểm cuối"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Giá vé"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginTop="2dp" />

    <!-- Hành động dành cho admin -->
    <LinearLayout
        android:id="@+id/adminActions"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:visibility="gone"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️ Sửa"
            android:textColor="#007A33"
            android:backgroundTint="#C8F7DC"
            android:background="@drawable/btn_rounded_green"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑️ Xóa"
            android:textColor="#D32F2F"
            android:backgroundTint="#FFEBEE"
            android:background="@drawable/btn_rounded_red"
            android:layout_marginStart="8dp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Nút mua vé -->
    <Button
        android:id="@+id/btnBuy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💳 Mua vé"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:textColor="#FFFFFF"
        android:backgroundTint="#007A33"
        android:textAllCaps="false" />
</LinearLayout>
