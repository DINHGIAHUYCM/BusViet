<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#F9FFF6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Cập nhật thông tin"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Bạn cần thay đổi thông tin tài khoản?"
            android:textSize="14sp"
            android:textColor="#B55C5C"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Name
         <TextView
            android:text="Tên người dùng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/editName"
            android:hint="Nhập tên"
            android:inputType="text"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
         -->


        <!-- Email
         <TextView
            android:text="Email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/editEmail"
            android:hint="example@gmail.com"
            android:inputType="textEmailAddress"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
         -->


        <!-- Phone -->
        <TextView
            android:text="Số điện thoại"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/editPhone"
            android:hint="Nhập số điện thoại"
            android:inputType="phone"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Contact -->
        <TextView
            android:text="Địa chỉ liên hệ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/editContact"
            android:hint="Nhập số liên hệ khẩn cấp"
            android:inputType="text"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- New Password -->
        <TextView
            android:text="Mật khẩu mới"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/edit_text_bg"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/editPassword"
                android:hint="Nhập mật khẩu mới"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/showPass"
                android:src="@android:drawable/ic_menu_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Confirm Password -->
        <TextView
            android:text="Xác nhận mật khẩu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/edit_text_bg"
            android:paddingEnd="12dp"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/editRePassword"
                android:hint="Nhập lại mật khẩu"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/showRePass"
                android:src="@android:drawable/ic_menu_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Update Button -->
        <Button
            android:id="@+id/buttonUpdate"
            android:text="Cập nhật"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E60000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <!-- Back to Homepage -->
        <TextView
            android:id="@+id/textHome"
            android:text="Về trang chủ"
            android:textColor="#555"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Back Button -->
        <Button
            android:id="@+id/buttonBack"
            android:text="Quay lại"
            android:backgroundTint="#DADADA"
            android:textColor="#000"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
