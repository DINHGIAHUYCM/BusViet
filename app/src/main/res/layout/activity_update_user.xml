<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cập nhật thông tin"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#007A33"
            android:background="#E9FCEF"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#E9FCEF" />

        <!-- Mô tả -->
        <TextView
            android:text="Bạn cần thay đổi thông tin tài khoản?"
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Số điện thoại -->
        <TextView
            android:text="Số điện thoại"
            android:textColor="#007A33"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/editPhone"
            android:hint="Nhập số điện thoại"
            android:inputType="phone"
            android:background="@drawable/bg_input_box"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Địa chỉ -->
        <TextView
            android:text="Địa chỉ"
            android:textColor="#007A33"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/editContact"
            android:hint="Nhập địa chỉ"
            android:inputType="text"
            android:background="@drawable/bg_input_box"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Mật khẩu mới -->
        <TextView
            android:text="Mật khẩu mới"
            android:textColor="#007A33"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_box"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp">
            <EditText
                android:id="@+id/editPassword"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Enter password" />

            <ImageView
                android:id="@+id/showPass"
                android:src="@android:drawable/ic_menu_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Xác nhận mật khẩu -->
        <TextView
            android:text="Xác nhận mật khẩu"
            android:textColor="#007A33"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_box"
            android:paddingEnd="12dp"
            android:layout_marginBottom="24dp">
            <EditText
                android:id="@+id/editRePassword"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Re-enter password" />

            <ImageView
                android:id="@+id/showRePass"
                android:src="@android:drawable/ic_menu_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Nút cập nhật -->
        <Button
            android:id="@+id/buttonUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#007A33"
            android:text="Cập nhật"
            android:textColor="#FFFFFF" />

        <!-- Nút quay lại -->
        <Button
            android:id="@+id/buttonBack"
            android:text="Quay lại"
            android:textColor="#007A33"
            android:background="@drawable/btn_outline_green"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="48dp" />
    </LinearLayout>
</ScrollView>
