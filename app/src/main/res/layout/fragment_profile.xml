<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Nút Đăng xuất ở góc trên bên phải -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đăng xuất"
        android:textColor="#007A33"
        android:textStyle="bold"
        android:backgroundTint="#E6F4EA"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp" />

    <!-- Tiêu đề trung tâm -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤 Thông tin tài khoản"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#007A33"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:layout_below="@id/btnLogout" />

    <!-- Khung thông tin -->
    <LinearLayout
        android:id="@+id/infoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E9FCEF"
        android:padding="24dp"
        android:layout_below="@id/tvTitle"
        android:layout_marginTop="24dp"
        android:elevation="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvUserInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Đang tải thông tin..."
            android:textSize="18sp"
            android:textColor="#333333"
            android:lineSpacingExtra="6dp" />
    </LinearLayout>

    <!-- Nút chỉnh sửa nằm dưới khung, căn phải -->
    <Button
        android:id="@+id/btnEditUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✏️ Sửa"
        android:textSize="14sp"
        android:backgroundTint="#007A33"
        android:textColor="#FFFFFF"
        android:layout_below="@id/infoCard"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:elevation="2dp" />

    <!-- Footer -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚌 BusViet - Hệ thống mua vé xe buýt"
        android:textSize="14sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="8dp" />
</RelativeLayout>
