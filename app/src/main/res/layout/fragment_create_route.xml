<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:elevation="6dp"
            android:padding="20dp"
            android:layout_gravity="center"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="48dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- Tiêu đề -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tạo Tuyến mới"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- Chú thích -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin sẽ tạo các tuyến mới với các mức giá quy định bởi bộ giao thông vận tải"
                android:textSize="14sp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etRouteCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mã số tuyến"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etStartPoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Điểm bắt đầu"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/etEndPoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Điểm kết thúc"
                android:minHeight="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mệnh giá vé"
                android:layout_marginTop="12dp" />

            <RadioGroup
                android:id="@+id/rgPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPrice120"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120.000" />

                <RadioButton
                    android:id="@+id/rbPrice250"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="250.000" />
            </RadioGroup>

            <Switch
                android:id="@+id/switchActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Tuyến đang hoạt động" />

            <Button
                android:id="@+id/btnCreate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tạo tuyến"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>