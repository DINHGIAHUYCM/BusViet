<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo tuyến và giá tuyến"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#007A33"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="8dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:backgroundTint="#E9FCEF"
            android:background="@drawable/edit_text_bg">

            <EditText
                android:id="@+id/etRouteCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mã số tuyến"
                android:minHeight="48dp"
                android:background="@drawable/edit_text_bg"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etStartPoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Điểm bắt đầu"
                android:minHeight="48dp"
                android:background="@drawable/edit_text_bg"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etEndPoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Điểm kết thúc"
                android:minHeight="48dp"
                android:background="@drawable/edit_text_bg"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <Switch
                android:id="@+id/switchActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tuyến đang hoạt động"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnCreate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tạo tuyến"
                android:textColor="#FFFFFF"
                android:backgroundTint="#007A33"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:elevation="2dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
