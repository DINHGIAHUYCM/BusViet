<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@drawable/bg_bus_item"
        android:elevation="2dp"
        android:layout_margin="16dp">

        <!-- Điểm bắt đầu -->
        <EditText
            android:id="@+id/etStartPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🚏 Điểm bắt đầu"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Điểm kết thúc -->
        <EditText
            android:id="@+id/etEndPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🏁 Điểm kết thúc"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Switch -->
        <Switch
            android:id="@+id/switchActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tuyến đang hoạt động"
            android:textSize="16sp"
            android:textColor="#007A33"
            android:layout_marginBottom="16dp" />

        <!-- Nút Lưu -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Lưu"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007A33"
            android:textSize="16sp"
            android:padding="12dp" />
    </LinearLayout>
</ScrollView>
